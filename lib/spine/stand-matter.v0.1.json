{
  "namespace": "stand",
  "name": "stand-matter",
  "version": "0.1",
  "definition": {
    "profile": "STAND Matter record (Case Floor)",
    "scope": "One real-life matter a person is working through: what they said, what they attached, what was checked against which published source, what deadlines were noted, what they did, and who confirmed or attested any of it.",
    "open_record": true,
    "roles": {
      "steward": "STAND itself, organizing the matter for the holder. Anything STAND records stays STAND's until the holder confirms it.",
      "holder": "The person whose matter this is. Owns the record and decides who else joins.",
      "helper": "Someone working the matter with the holder: an advocate, a field representative, a family member.",
      "witness": "Someone who can attest to a specific fact or document from their own knowledge."
    },
    "opening": { "event_type": "session_opened", "role": "steward" },
    "authority": {
      "participant_added": ["steward", "holder"],
      "statement_recorded": ["holder", "steward"],
      "document_attached": ["holder", "steward", "helper"],
      "fact_logged": ["holder", "steward"],
      "claim_checked": ["steward"],
      "deadline_noted": ["steward", "holder"],
      "record_confirmed": ["holder"],
      "action_taken": ["holder", "helper"],
      "witness_attested": ["witness"],
      "correction_linked": ["holder", "steward"],
      "note_recorded": ["holder", "steward", "helper"],
      "session_closed": ["holder", "steward"]
    },
    "references": {
      "fact_logged": [{ "field": "source_event_sha256", "event_type": ["statement_recorded", "document_attached"] }],
      "record_confirmed": [{ "field": "event_sha256s", "event_type": ["statement_recorded", "fact_logged", "claim_checked", "deadline_noted", "document_attached"], "many": true }],
      "witness_attested": [{ "field": "event_sha256", "event_type": ["fact_logged", "document_attached", "statement_recorded"] }],
      "correction_linked": [{ "field": "corrects_event_sha256", "event_type": ["statement_recorded", "fact_logged", "claim_checked", "deadline_noted", "document_attached", "note_recorded"] }]
    },
    "outcomes": {
      "statement_recorded": { "field": "entry_source", "allowed": ["typed_by_holder", "spoken_by_holder", "transcribed_by_steward"] },
      "claim_checked": { "field": "result", "allowed": ["confirmed", "contradicted", "cannot_verify"] },
      "record_confirmed": { "field": "confirmation", "allowed": ["accurate", "inaccurate"] }
    },
    "fields": {
      "statement_recorded": ["text"],
      "fact_logged": ["statement"],
      "claim_checked": ["claim", "source_title", "source_url", "source_text_sha256"],
      "deadline_noted": ["description", "due", "controlling_source"],
      "action_taken": ["action"],
      "witness_attested": ["statement"],
      "correction_linked": ["reason"],
      "note_recorded": ["text"]
    },
    "evidence": {
      "document_attached": { "hash_field": "evidence_sha256", "required_fields": ["title", "media_type"] }
    },
    "completion": {
      "session_closed": ["statement_recorded"]
    },
    "read_roles": ["steward", "holder", "helper", "witness"],
    "export_roles": ["holder", "steward"],
    "boundary": "This record shows what the holder said, what was attached, what was checked against which published source, and who confirmed or attested it. It is not legal advice and does not decide who is right. A statement is the holder's own; a fact is attested only where a witness signed it. Anything STAND recorded is STAND's organizing work until the holder confirms it."
  }
}
