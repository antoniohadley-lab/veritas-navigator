// Veritas / STAND — Shared Event Ledger (Prisma 7)
// Connection URL is in prisma.config.ts (Prisma 7 requirement).
// To apply schema to Supabase: see supabase-migration.sql in the prisma/ directory.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Case ─────────────────────────────────────────────────────────────────────

model Case {
  id        String     @id @default(cuid())
  userId    String
  caseType  CaseType
  status    CaseStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  fieldJobs        FieldJob[]
  events           VerificationEvent[]
  narrativeEntries NarrativeEntry[]
  issueTracks      IssueTrack[]
  actors           Actor[]
  timelineEvents   TimelineEvent[]
  claims           Claim[]
  documents        Document[]
  outputs          Output[]
}

enum CaseType {
  FORECLOSURE
  EVICTION
  CUSTODY
  CIVIL_DISPUTE
  BUSINESS_FORMATION
  OTHER
}

enum CaseStatus {
  ACTIVE
  CLOSED
  ARCHIVED
}

// ─── FieldJob ─────────────────────────────────────────────────────────────────
// One row per physical field visit. caseId null = standalone VROS booking.

model FieldJob {
  id                   String      @id @default(cuid())
  caseId               String?
  case                 Case?       @relation(fields: [caseId], references: [id])
  serviceType          ServiceType
  clientName           String
  location             String
  scheduledWindowStart DateTime?
  scheduledWindowEnd   DateTime?
  status               JobStatus   @default(SCHEDULED)
  feeQuoted            Decimal?
  feeCollected         Decimal?
  createdAt            DateTime    @default(now())

  events VerificationEvent[]
}

enum ServiceType {
  NOTARY
  PROCESS_SERVICE
  PROPERTY_INSPECTION
  SPECIMEN_COURIER
  OTHER
}

enum JobStatus {
  SCHEDULED
  EN_ROUTE
  ON_SITE
  COMPLETED
  MISSED
  CANCELLED
}

// ─── VerificationEvent ────────────────────────────────────────────────────────
// Immutable event log shared by STAND triage and VROS field visits.
// evidenceHash is SHA-256 computed at write time, never updated.
// Factual Packet = all events for a caseId ordered by timestamp, rendered to PDF.

model VerificationEvent {
  id           String      @id @default(cuid())
  caseId       String?
  case         Case?       @relation(fields: [caseId], references: [id])
  fieldJobId   String?
  fieldJob     FieldJob?   @relation(fields: [fieldJobId], references: [id])
  actorId      String
  roleType     String      // "litigant" | "notary" | "process_server" | "inspector"
  eventType    EventType
  payloadType  String      // "document" | "property" | "specimen" | "case_note"
  payloadRef   String?
  timestamp    DateTime    @default(now())
  geoLat       Float?
  geoLng       Float?
  evidenceUri  String?
  notes        String?
  priorEventId String?
  evidenceHash String?

  // source_retrieved — structured source fields (null for other event types)
  sourceUrl        String?
  sourceTitle      String?
  sourceTextHash   String?
  verifiedDate     DateTime?

  // result_displayed — structured verification result (null for other event types)
  verificationStatus VerificationStatus?

  // Evidence-grammar tag: how this event's user-facing text was produced
  origin ContentOrigin?
}

enum EventType {
  // STAND Verification Check flow
  claim_logged
  source_retrieved
  source_not_found
  consistency_checked
  result_displayed
  affidavit_drafted
  form_check_run
  exhibit_cross_referenced
  finalized
  // BYO AI Cross-Check flow
  document_drafted
  cross_check_pass
  discrepancies_flagged
  // VROS field events
  arrival
  photo_captured
  affidavit_executed
  report_exported
}

enum VerificationStatus {
  match
  mismatch
  cannot_verify
}

// Evidence-grammar tag: source of user-facing text — required by UPL disclosure standard §8.
// Every AI-touched output must be visibly labeled in the UI when origin = ai_suggested_rewrite.
enum ContentOrigin {
  user_entered
  system_derived
  ai_suggested_rewrite
}

// ─── RuleSource ───────────────────────────────────────────────────────────────
// Bounded universe of verified statutory text the Verification Check may compare against.
// The AI is never allowed to compare against open-web text or its own training data —
// only against rows in this table where lastVerifiedDate is within staleAfterDays.

model RuleSource {
  id               String   @id @default(cuid())
  jurisdiction     String   // "michigan" | "federal" | "wayne_county" ...
  topic            String   // "eviction notice period" | "foia response window" ...
  sourceType       RuleSourceType
  exactText        String   // verbatim statutory text — no paraphrase, no summary
  sourceUrl        String
  lastVerifiedDate DateTime
  // Signed verification log — per Bible §5: "Last verified by [initials], [date], confirmed against [URL]"
  // A timestamp alone is not the same claim as a signed log that holds up under institutional audit.
  verifiedBy       String?
  staleAfterDays   Int      @default(45)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum RuleSourceType {
  statute
  court_rule
  official_form
  administrative_rule
}

// ─── NarrativeEntry ──────────────────────────────────────────────────────────
// Raw text verbatim, exactly as the user typed it. Never edited, never paraphrased.
// All structured extractions (TimelineEvents, Actors, Claims) trace back here.

model NarrativeEntry {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id])
  text      String
  createdAt DateTime @default(now())

  timelineEvents TimelineEvent[]
}

// ─── IssueTrack ───────────────────────────────────────────────────────────────
// One row per legal issue identified in the Case, classified after intake.
// A single Case can produce multiple IssueTracks (e.g. nonpayment + security deposit).

model IssueTrack {
  id           String      @id @default(cuid())
  caseId       String
  case         Case        @relation(fields: [caseId], references: [id])
  category     String      // "housing_eviction" | "security_deposit" | "foia" | ...
  subcategory  String?
  status       IssueStatus @default(OPEN)
  classifiedBy String      // "system" or the actorId of the human reviewer
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  claims Claim[]
}

enum IssueStatus {
  OPEN
  RESOLVED
  ESCALATED
  CLOSED
}

// ─── Actor ────────────────────────────────────────────────────────────────────
// People, agencies, and institutions named in the narrative.

model Actor {
  id          String   @id @default(cuid())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id])
  name        String
  role        String   // "landlord" | "tenant" | "court" | "agency" | "creditor" | ...
  contactInfo String?
  createdAt   DateTime @default(now())

  timelineEvents TimelineEvent[]
}

// ─── TimelineEvent ────────────────────────────────────────────────────────────
// Structured events extracted from the narrative, ordered by when they occurred in the world.
// Distinct from VerificationEvent: TimelineEvents record what happened to the user;
// VerificationEvents record what STAND/VROS did in response.

model TimelineEvent {
  id               String          @id @default(cuid())
  caseId           String
  case             Case            @relation(fields: [caseId], references: [id])
  occurredAt       DateTime
  label            String          // "Landlord sent written notice"
  origin           ContentOrigin
  narrativeEntryId String?
  narrativeEntry   NarrativeEntry? @relation(fields: [narrativeEntryId], references: [id])
  actorId          String?
  actor            Actor?          @relation(fields: [actorId], references: [id])
  createdAt        DateTime        @default(now())

  claims    Claim[]
  documents Document[]
}

// ─── Claim ────────────────────────────────────────────────────────────────────
// A specific factual assertion the user wants verified against the Rule Store.
// One Claim per assertion — never bundle multiple facts into one row.

model Claim {
  id                 String             @id @default(cuid())
  caseId             String
  case               Case               @relation(fields: [caseId], references: [id])
  issueTrackId       String?
  issueTrack         IssueTrack?        @relation(fields: [issueTrackId], references: [id])
  timelineEventId    String?
  timelineEvent      TimelineEvent?     @relation(fields: [timelineEventId], references: [id])
  statement          String             // the factual assertion, exactly as stated
  verificationStatus VerificationStatus @default(cannot_verify)
  ruleSourceId       String?
  checkedAt          DateTime?
  origin             ContentOrigin
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  documents Document[]
}

// ─── Document ─────────────────────────────────────────────────────────────────
// Uploaded files. hash is SHA-256 hex computed at write time, never updated.

model Document {
  id              String         @id @default(cuid())
  caseId          String
  case            Case           @relation(fields: [caseId], references: [id])
  filename        String
  mimeType        String
  storageUri      String
  hash            String
  claimId         String?
  claim           Claim?         @relation(fields: [claimId], references: [id])
  timelineEventId String?
  timelineEvent   TimelineEvent? @relation(fields: [timelineEventId], references: [id])
  uploadedAt      DateTime       @default(now())
}

// ─── Output ───────────────────────────────────────────────────────────────────
// Records every packet or document generated from this Case.
// Factual Packet generation writes one Output row + one VerificationEvent(report_exported).

model Output {
  id              String         @id @default(cuid())
  caseId          String
  case            Case           @relation(fields: [caseId], references: [id])
  outputType      OutputType
  generatedAt     DateTime       @default(now())
  deliveryStatus  DeliveryStatus @default(GENERATED)
  stripePaymentId String?
  packetId        String?        // matches coverPage.packetId in factual-packet.ts
  contentsRef     String?        // storage URI to the generated file
}

enum OutputType {
  FACTUAL_PACKET
  AFFIDAVIT_DRAFT
  FORM_PREFILL
  SUMMARY
}

enum DeliveryStatus {
  GENERATED
  DELIVERED
  ARCHIVED
}
